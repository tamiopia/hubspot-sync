PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hubspot_sync

# Redis Connection (Idempotency Locks)
REDIS_URL=redis://localhost:6379

# Security: 32-byte Hex String for AES-256-GCM encryption
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# HubSpot OAuth App Credentials
HUBSPOT_CLIENT_ID=your-hubspot-client-id
HUBSPOT_CLIENT_SECRET=your-hubspot-client-secret
HUBSPOT_REDIRECT_URI=https://hearing-spotlight-submissions-cartoons.trycloudflare.com/auth/hubspot/callback

# Wix App Configuration
WIX_APP_ID=your-wix-app-id
WIX_APP_SECRET=your-wix-app-secret
